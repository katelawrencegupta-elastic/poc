        "data_source": {
          "type": "esql",
          "query": "FROM ct_sitedata_ext2_indicator_events_m-2026.07.01\n| WHERE indicator_severity == \"Warning\"\n| STATS `Warning Issues` = COUNT(*)"
        },
        "metrics": [
          {
            "type": "primary",
            "column": "Warning Issues"
          }
        ]
      }
    },
    {
