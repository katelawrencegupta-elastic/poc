      },
      "config": {
        "title": "",
        "type": "metric",
        "data_source": {
          "type": "esql",
          "query": "FROM ct_sitedata_ext2_indicator_events_m-2026.07.01\n| STATS `Systems` = COUNT_DISTINCT(sysid)"
        },
        "metrics": [
          {
            "type": "primary",
            "column": "Systems"
          }
