{
  "title": "GEH Hospital Detail \u2014 Issues, Repairs, Parts & Manuals",
  "description": "Hospital drilldown: Critical/Warning messages by sysId & hospital, correlated with repair history, part lists, and device manuals.",
  "time_range": {
    "from": "2026-07-01T00:00:00.000Z",
    "to": "now"
  },
  "query": {
    "language": "kql",
    "expression": ""
  },
  "panels": [
    {
      "type": "vis",
      "id": "m-critical",
      "grid": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "config": {
        "title": "",
        "type": "metric",
        "data_source": {
          "type": "esql",
          "query": "FROM ct_sitedata_ext2_indicator_events_m-2026.07.01\n| WHERE indicator_severity == \"Critical\"\n| STATS `Critical Issues` = COUNT(*)"
        },
        "metrics": [
          {
            "type": "primary",
            "column": "Critical Issues"
          }
        ]
      }
    },
    {
      "type": "vis",
      "id": "m-warning",
      "grid": {
