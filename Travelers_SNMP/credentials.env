# SNMP credentials — Travelers synthetic lab

SNMP_COMMUNITY=public
SNMP_VERSION=2c

SNMP_V3_USER=user7
SNMP_V3_LEVEL=authPriv
SNMP_V3_AUTH_PROTO=SHA
SNMP_V3_AUTH_KEY=1234567890abcdef
SNMP_V3_PRIV_PROTO=AES
SNMP_V3_PRIV_KEY=1234567890abcdef

