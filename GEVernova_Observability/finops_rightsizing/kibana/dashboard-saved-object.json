        "layers": [
          {
            "sampling": 1,
            "ignore_global_filters": false,
            "data_source": {
              "type": "esql",
              "query": "FROM metrics-aws.ec2_metrics-*\n| WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend\n| STATS cpu_avg = ROUND(AVG(aws.ec2.metrics.CPUUtilization.avg), 2),\n        cpu_p95 = ROUND(PERCENTILE(aws.ec2.metrics.CPUUtilization.avg, 95), 2),\n        samples = COUNT(*)\n    BY instance = cloud.instance.name, account = cloud.account.id, instance_id = cloud.instance.id, machine = cloud.machine.type\n| WHERE cpu_avg IS NOT NULL\n| SORT cpu_avg ASC\n| LIMIT 50"
            },
            "type": "line",
            "breakdown_by": {
              "column": "instance",
              "label": "Instance",
              "color": {
                "mode": "categorical",
                "palette": "elastic_line_optimized",
                "mapping": []
              }
            },
            "y": [
              {
                "column": "cpu_p95",
                "label": "CPU p95 %",
                "axis": "y",
                "color": {
                  "type": "auto"
                }
              }
            ],
            "x": {
              "column": "cpu_avg",
              "label": "CPU avg %"
            }
          }
        ],
