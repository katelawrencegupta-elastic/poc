        "data_source": {
          "type": "esql",
          "query": "FROM metrics-aws.ec2_metrics-*\n| WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend\n    AND cloud.instance.id IS NOT NULL\n| EVAL instance = CONCAT(COALESCE(cloud.instance.name, \"ec2\"), \" \", cloud.instance.id)\n| STATS cpu = ROUND(AVG(aws.ec2.metrics.CPUUtilization.avg), 2)\n    BY t = BUCKET(@timestamp, 24, ?_tstart, ?_tend), instance\n| WHERE cpu IS NOT NULL\n| SORT t ASC\n| KEEP t, instance, cpu"
        },
        "styling": {
          "cells": {
            "labels": {
              "visible": false
            }
          }
        },
        "metric": {
          "column": "cpu",
