{
  "source": {
    "index": ["logs-finops.rightsizing-default"]
  },
  "dest": {
    "index": "finops-rightsizing-latest"
  },
  "latest": {
    "unique_key": ["finops.rightsizing.id"],
    "sort": "@timestamp"
  },
  "frequency": "5m",
  "sync": {
    "time": {
      "field": "@timestamp",
      "delay": "60s"
    }
  },
  "description": "Current rightsizing recommendation per fingerprint. Dashboards should prefer this index over the raw data stream."
}
