            "data_source": {
              "type": "esql",
              "query": "FROM traces-generic.otel-default\n| WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend\n    AND `attributes.span.destination.service.resource` == \"postgresql\"\n    AND `attributes.span.duration.us` >= 1000000\n| EVAL rds_short = CASE(\n     COALESCE(`attributes.server.address`, `attributes.net.peer.name`) LIKE \"*classic-stage-rds*\", \"classic-stage-rds\",\n     COALESCE(`attributes.server.address`, `attributes.net.peer.name`) LIKE \"*perf-db1*\", \"meridium-perf-db1\",\n     COALESCE(`attributes.server.address`, `attributes.net.peer.name`) LIKE \"*alerts-postgres*\", \"alerts-postgres\",\n     COALESCE(`attributes.server.address`, `attributes.net.peer.name`) LIKE \"*cases-postgres*\", \"cases-postgres\",\n     COALESCE(`attributes.server.address`, `attributes.net.peer.name`) LIKE \"*iam-uaa-postgres*\", \"iam-uaa-postgres\",\n     COALESCE(`attributes.server.address`, `attributes.net.peer.name`)\n   )\n| STATS slow = COUNT(*)\n    BY t = BUCKET(@timestamp, 60, ?_tstart, ?_tend), rds_short\n| KEEP t, rds_short, slow\n| SORT t ASC\n| LIMIT 2000\n"
