{
  "name": "[SRE] OpenSearch used-space % > 85",
  "tags": [
    "sre",
    "ge-vernova",
    "opensearch",
    "aws-es"
  ],
  "consumer": "observability",
  "rule_type_id": "observability.rules.custom_threshold",
  "schedule": {
    "interval": "5m"
  },
  "enabled": true,
  "params": {
    "criteria": [
      {
        "comparator": ">",
        "metrics": [
          {
            "name": "A",
            "aggType": "max",
            "field": "aws.es.metrics.ClusterUsedSpace.max"
          },
          {
            "name": "B",
            "aggType": "avg",
            "field": "aws.es.metrics.FreeStorageSpace.avg"
          }
        ],
        "threshold": [
          85
        ],
        "timeSize": 15,
        "timeUnit": "m",
        "equation": "(A / (A + B)) * 100"
      }
    ],
    "alertOnNoData": false,
    "alertOnGroupDisappear": false,
    "groupBy": [
      "aws.dimensions.DomainName",
      "cloud.account.id",
      "cloud.region"
    ],
    "searchConfiguration": {
      "index": "31f4433d-7968-4434-9446-dc5aba18221a",
      "query": {
        "language": "kuery",
        "query": "aws.cloudwatch.namespace : \"AWS/ES\" and not aws.dimensions.NodeId : *"
      }
    }
  },
  "actions": [
    {
      "group": "custom_threshold.fired",
      "id": "gev-sre-server-log",
      "params": {
        "message": "P2 OpenSearch used-space % > 85 for 15m (USW Splunk formula). P1 sibling fires at 90. Dashboard: https://my-observability-project-f2e495.kb.us-west-2.aws.elastic.cloud/s/sre/app/dashboards#/view/sre-opensearch-domain?_g=(time:(from:now-1h,to:now))",
        "level": "info"
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActionGroupChange",
        "throttle": null
      }
    }
  ]
}