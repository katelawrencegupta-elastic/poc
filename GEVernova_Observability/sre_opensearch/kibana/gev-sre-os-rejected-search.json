{
  "name": "[SRE] OpenSearch search threadpool rejected",
  "tags": [
    "sre",
    "ge-vernova",
    "opensearch",
    "aws-es"
  ],
  "consumer": "observability",
  "rule_type_id": "observability.rules.custom_threshold",
  "schedule": {
    "interval": "5m"
  },
  "enabled": true,
  "params": {
    "criteria": [
      {
        "comparator": ">",
        "metrics": [
          {
            "name": "A",
            "aggType": "sum",
            "field": "aws.es.metrics.ThreadpoolSearchRejected.sum"
          }
        ],
        "threshold": [
          0
        ],
        "timeSize": 15,
        "timeUnit": "m"
      }
    ],
    "alertOnNoData": false,
    "alertOnGroupDisappear": false,
    "groupBy": [
      "aws.dimensions.DomainName",
      "aws.dimensions.NodeId",
      "cloud.account.id",
      "cloud.region"
    ],
    "searchConfiguration": {
      "index": "31f4433d-7968-4434-9446-dc5aba18221a",
      "query": {
        "language": "kuery",
        "query": "aws.cloudwatch.namespace : \"AWS/ES\" and aws.dimensions.NodeId : *"
      }
    }
  },
  "actions": [
    {
      "group": "custom_threshold.fired",
      "id": "gev-sre-server-log",
      "params": {
        "message": "P2 OpenSearch ThreadpoolSearchRejected > 0 over 15m. Not in Splunk AWS/ES detectors. Dashboard: https://my-observability-project-f2e495.kb.us-west-2.aws.elastic.cloud/s/sre/app/dashboards#/view/sre-opensearch-node?_g=(time:(from:now-1h,to:now))",
        "level": "info"
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActionGroupChange",
        "throttle": null
      }
    },
    {
      "group": "custom_threshold.fired",
      "id": "system-connector-.workflows",
      "params": {
        "subAction": "run",
        "subActionParams": {
          "workflowId": "gev-sre-os-rejected-search-case",
          "summaryMode": false,
          "alertStates": {
            "new": true,
            "ongoing": false,
            "recovered": true
          }
        }
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActionGroupChange",
        "throttle": null
      }
    }
  ]
}